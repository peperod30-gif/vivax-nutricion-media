     "texto": "Tres frases sobre azúcar. Crema de cacao: más de la mitad son azúcares.",
     "t0": 0.0213,
     "t1": 4.2313
    },
    {
     "id": "v0",
     "texto": "¡Verdadero!",
     "t0": 4.9314,
     "t1": 5.5714
    },
    {
     "id": "a1",
     "texto": "Un café solo, sin nada, ya lleva azúcares.",
     "t0": 7.0614,
     "t1": 9.7014
    },
    {
     "id": "v1",
     "texto": "¡Falso! Cero coma cero.",
     "t0": 10.3464,
     "t1": 12.0114
    },
    {
     "id": "a2",
     "texto": "El azúcar blanco es cien por cien azúcares.",
     "t0": 13.2914,
     "t1": 15.6514
    },
    {
     "id": "v2",
     "texto": "¡Falso! Noventa y nueve coma ocho.",
     "t0": 16.3064,
     "t1": 18.3064
    },
    {
     "id": "c",
     "texto": "¿Y el hummus? Cero coma seis gramos.",
     "t0": 19.3929,
     "t1": 21.5099
    },
    {
     "id": "f",
     "texto": "Mándaselo a quien unta crema de cacao a escondidas.",
     "t0": 22.1029,
     "t1": 24.5299
    }
   ]
